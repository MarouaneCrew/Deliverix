{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["apps/api/src/**/*.ts", "apps/api/test/**/*.ts"]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noConstAssign": "error",
        "noEmptyPattern": "error",
        "noUnreachable": "error",
        "useExhaustiveDependencies": "off"
      },
      "style": {
        "useConst": "error",
        "useImportType": "on",
        "useTemplate": "on"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noImplicitAnyLet": "warn",
        "noExplicitAny": "off",
        "noArrayIndexKey": "warn"
      },
      "complexity": {
        "noBannedTypes": "error",
        "noExtraBooleanCast": "error",
        "noStaticOnlyClass": "error",
        "noUselessConstructor": "error",
        "noUselessRename": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": true,
      "bracketSameLine": false
    },
    "globals": [
      "BigInt",
      "Console",
      "CustomEvent",
      "Error",
      "EvalError",
      "FocusEvent",
      "FormData",
      "HTMLFormElement",
      "Image",
      "Map",
      "Math",
      "Promise",
      "RangeError",
      "ReferenceError",
      "Response",
      "Symbol",
      "TypeError",
      "URL",
      "URLSearchParams",
      "WebAssembly",
      "addEventListener",
      "alert",
      "atob",
      "blur",
      "btoa",
      "cancelAnimationFrame",
      "captureEvents",
      "clearInterval",
      "clearTimeout",
      "close",
      "closed",
      "confirm",
      "console",
      "customElements",
      "decodeURI",
      "decodeURIComponent",
      "defaultStatus",
      "document",
      "encodeURI",
      "encodeURIComponent",
      "Error",
      "escape",
      "event",
      "external",
      "fetch",
      "FileReader",
      "finally",
      "focus",
      "frameElement",
      "frames",
      "Function",
      "getAllResponseHeaders",
      "getResponseHeader",
      "history",
      "Image",
      "isFinite",
      "isNaN",
      "JSON",
      "location",
      "locationbar",
      "matchMedia",
      "menubar",
      "moveBy",
      "moveTo",
      "MutationObserver",
      "name",
      "navigator",
      "newline",
      "Node",
      "NodeList",
      "onerror",
      "ondblclick",
      "onkeydown",
      "onkeypress",
      "onkeyup",
      "onload",
      "onmousedown",
      "onmousemove",
      "onmouseup",
      "onmouseout",
      "onmouseover",
      "onmouseup",
      "open",
      "option",
      "outerHeight",
      "outerWidth",
      "pageXOffset",
      "pageYOffset",
      "parent",
      "performance",
      "parseFloat",
      "parseInt",
      "performance",
      "postMessage",
      "print",
      "prompt",
      "queueMicrotask",
      "releaseEvents",
      "removeEventListener",
      "resizeBy",
      "resizeTo",
      "screen",
      "screenLeft",
      "screenTop",
      "screenX",
      "screenY",
      "scroll",
      "scrollBy",
      "scrollTo",
      "scrollbars",
      "self",
      "setInterval",
      "setTimeout",
      "status",
      "stop",
      "StructuredClone",
      "substring",
      "Symbol",
      "toLocaleString",
      "toPrecision",
      "toString",
      "trigger",
      "unescape",
      "unity",
      "unescape",
      "URL",
      "URLSearchParams",
      "UserActivation",
      "validateForm",
      "visibilityState",
      "VisualViewport",
      "watch",
      "XMLHttpRequest"
    ]
  },
  "overrides": [
    {
      "includes": ["apps/api/src/**/*.ts"],
      "javascript": {
        "parser": {
          "unsafeParameterDecoratorsEnabled": true
        }
      }
    }
  ]
}
